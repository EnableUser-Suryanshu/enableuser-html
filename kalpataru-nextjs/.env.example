# ---------------------------------------------------------------------------
# Licensed exchange data feed — TrueData (NSE EQ/FO/Indices, BSE, MCX)
# ---------------------------------------------------------------------------
# Copy to .env.local for local builds, and add the same two variables in
# Vercel → Project → Settings → Environment Variables for deployments.
#
# When these are set, `npm run build` pulls NSE / BSE / MCX data from the
# licensed feed. When they are absent the build automatically falls back to
# NSE's public endpoints, so the site never ships empty.

TRUEDATA_USERNAME=
TRUEDATA_PASSWORD=

# Optional overrides (defaults shown)
# TRUEDATA_AUTH_URL=https://auth.truedata.in/token
# TRUEDATA_HISTORY_URL=https://history.truedata.in
